{
  "name": "plataforma-recursos-pedagogicos",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @app/api --filter @app/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:generate": "pnpm --filter @pkg/db db:generate",
    "db:migrate": "pnpm --filter @pkg/db db:migrate",
    "db:seed": "pnpm --filter @pkg/db db:seed",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "resolve-pkg-maps": "^1.0.0"
  }
}
